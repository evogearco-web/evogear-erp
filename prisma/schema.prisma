generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { ADMIN MANAGER STAFF VIEWER }
enum QuotationStatus { DRAFT SENT ACCEPTED REJECTED EXPIRED }
enum SalesOrderStatus { PENDING CONFIRMED IN_PRODUCTION SHIPPED COMPLETED CANCELLED }
enum SupplierOrderStatus { DRAFT ORDERED PAID IN_PRODUCTION SHIPPED RECEIVED CANCELLED }
enum ShipmentStatus { PENDING IN_TRANSIT DELIVERED DELAYED }
enum PaymentStatus { UNPAID PARTIALLY_PAID PAID OVERDUE }
enum PaymentType { DEPOSIT BALANCE FULL_PAYMENT REFUND }
enum Currency { SGD RMB USD }

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id          String      @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String
  address     String
  notes       String?
  quotations  Quotation[]
  salesOrders SalesOrder[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([companyName])
  @@index([email])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contactName    String
  email          String
  phone          String
  country        String
  currency       Currency
  address        String
  notes          String?
  products       Product[]
  supplierOrders SupplierOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([name])
}

model Product {
  id                 String              @id @default(cuid())
  name               String
  category           String
  description        String
  supplierId         String
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  costCurrency       Currency
  costPrice          Decimal             @db.Decimal(12, 2)
  sellingPrice       Decimal             @db.Decimal(12, 2)
  moq                Int
  unit               String
  weightKg           Decimal             @db.Decimal(8, 2)
  quotationItems     QuotationItem[]
  salesOrderItems    SalesOrderItem[]
  supplierOrderItems SupplierOrderItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([name])
  @@index([category])
}

model Quotation {
  id                String          @id @default(cuid())
  quotationNumber   String          @unique
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id])
  status            QuotationStatus @default(DRAFT)
  currency          Currency
  exchangeRate      Decimal         @db.Decimal(10, 4)
  subtotal          Decimal         @db.Decimal(12, 2)
  shippingCost      Decimal         @db.Decimal(12, 2)
  totalCost         Decimal         @db.Decimal(12, 2)
  totalSellingPrice Decimal         @db.Decimal(12, 2)
  grossProfit       Decimal         @db.Decimal(12, 2)
  grossMargin       Decimal         @db.Decimal(5, 2)
  validUntil        DateTime
  items             QuotationItem[]
  salesOrder        SalesOrder?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([customerId, status])
}

model QuotationItem {
  id               String    @id @default(cuid())
  quotationId      String
  quotation        Quotation @relation(fields: [quotationId], references: [id])
  productId        String
  product          Product   @relation(fields: [productId], references: [id])
  description      String
  quantity         Int
  unitCost         Decimal   @db.Decimal(12, 2)
  unitSellingPrice Decimal   @db.Decimal(12, 2)
  lineCost         Decimal   @db.Decimal(12, 2)
  lineSellingPrice Decimal   @db.Decimal(12, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SalesOrder {
  id                   String           @id @default(cuid())
  salesOrderNumber     String           @unique
  quotationId          String?          @unique
  quotation            Quotation?       @relation(fields: [quotationId], references: [id])
  customerId           String
  customer             Customer         @relation(fields: [customerId], references: [id])
  status               SalesOrderStatus @default(PENDING)
  orderDate            DateTime
  expectedDeliveryDate DateTime?
  totalSellingPrice    Decimal          @db.Decimal(12, 2)
  items                SalesOrderItem[]
  supplierOrders       SupplierOrder[]
  payments             Payment[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([customerId, status])
  @@index([orderDate])
}

model SalesOrderItem {
  id               String     @id @default(cuid())
  salesOrderId     String
  salesOrder       SalesOrder @relation(fields: [salesOrderId], references: [id])
  productId        String
  product          Product    @relation(fields: [productId], references: [id])
  description      String
  quantity         Int
  unitSellingPrice Decimal    @db.Decimal(12, 2)
  lineSellingPrice Decimal    @db.Decimal(12, 2)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model SupplierOrder {
  id                      String              @id @default(cuid())
  supplierOrderNumber     String              @unique
  supplierId              String
  supplier                Supplier            @relation(fields: [supplierId], references: [id])
  salesOrderId            String
  salesOrder              SalesOrder          @relation(fields: [salesOrderId], references: [id])
  status                  SupplierOrderStatus @default(DRAFT)
  currency                Currency
  exchangeRate            Decimal             @db.Decimal(10, 4)
  subtotalForeignCurrency Decimal             @db.Decimal(12, 2)
  subtotalSgd             Decimal             @db.Decimal(12, 2)
  shippingCostSgd         Decimal             @db.Decimal(12, 2)
  totalCostSgd            Decimal             @db.Decimal(12, 2)
  items                   SupplierOrderItem[]
  shipment                Shipment?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([supplierId, status])
}

model SupplierOrderItem {
  id                      String        @id @default(cuid())
  supplierOrderId         String
  supplierOrder           SupplierOrder @relation(fields: [supplierOrderId], references: [id])
  productId               String
  product                 Product       @relation(fields: [productId], references: [id])
  description             String
  quantity                Int
  unitCostForeignCurrency Decimal       @db.Decimal(12, 2)
  lineCostForeignCurrency Decimal       @db.Decimal(12, 2)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}

model Shipment {
  id             String         @id @default(cuid())
  supplierOrderId String        @unique
  supplierOrder  SupplierOrder  @relation(fields: [supplierOrderId], references: [id])
  shippingMethod String
  trackingNumber String?
  weightKg       Decimal        @db.Decimal(8, 2)
  boxCount       Int
  costSgd        Decimal        @db.Decimal(12, 2)
  status         ShipmentStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
}

model Payment {
  id          String        @id @default(cuid())
  salesOrderId String
  salesOrder  SalesOrder    @relation(fields: [salesOrderId], references: [id])
  amount      Decimal       @db.Decimal(12, 2)
  currency    Currency
  paymentType PaymentType
  status      PaymentStatus @default(UNPAID)
  dueDate     DateTime
  paidDate    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([salesOrderId, status])
}
